# Public, non-secret defaults so a clean checkout runs with mocks.
# Override locally in .env.local (gitignored).
VITE_API_URL=/api
VITE_SOCKET_URL=https://realtime.nft-market.mock
VITE_ENABLE_MOCKS=true
# Default MSW scenario (see src/mocks/scenarios). Can be overridden at runtime via ?scenario=
VITE_MOCK_SCENARIO=default
